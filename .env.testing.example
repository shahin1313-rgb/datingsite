APP_NAME="Dating Site Tests"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=4

LOG_CHANNEL=single
LOG_LEVEL=debug

# Safe default: a persistent, dedicated SQLite test database.
DB_CONNECTION=sqlite
DB_DATABASE=database/testing.sqlite

# Must exactly equal DB_DATABASE. This explicit confirmation blocks accidental
# use of another persistent database. For the current development MySQL
# database, copy its DB_* values here and repeat its exact name below.
TEST_DATABASE_CONFIRMATION=database/testing.sqlite

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false

PREMIUM_BSC_RPC_URL=https://bsc-rpc.example.test
PREMIUM_BSC_WALLET_ADDRESS=0x1111111111111111111111111111111111111111
PREMIUM_USDT_MIN_AMOUNT_ATOMIC=500000000000000000
PREMIUM_BSC_CONFIRMATIONS=12
PREMIUM_DAYS=30
PREMIUM_PAYMENT_INTENT_MINUTES=60
